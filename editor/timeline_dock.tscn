[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://addons/construction_4d_tool/editor/timeline_dock.gd" id="1_dock"]

[node name="TimelineDock" type="ScrollContainer"]
custom_minimum_size = Vector2(340, 0)
horizontal_scroll_mode = 0
script = ExtResource("1_dock")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="TargetLabel" type="Label" parent="VBox"]
layout_mode = 2
autowrap_mode = 2
text = "No SequenceManager found in the open scene."

[node name="Buttons" type="HFlowContainer" parent="VBox"]
layout_mode = 2

[node name="LoadIfcButton" type="Button" parent="VBox/Buttons"]
layout_mode = 2
text = "Load IFC (4D)"

[node name="IfcMenu" type="MenuButton" parent="VBox/Buttons"]
layout_mode = 2
text = "▾"
flat = false

[node name="PreviewButton" type="Button" parent="VBox/Buttons"]
layout_mode = 2
disabled = true
text = "Start Preview"

[node name="ImportButton" type="Button" parent="VBox/Buttons"]
layout_mode = 2
disabled = true
text = "Importar…"

[node name="EquipmentButton" type="Button" parent="VBox/Buttons"]
layout_mode = 2
text = "Maquinaria"

[node name="PreviewSection" type="VBoxContainer" parent="VBox"]
visible = false
layout_mode = 2
size_flags_vertical = 3

[node name="WarningLabel" type="Label" parent="VBox/PreviewSection"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.3, 0.3, 1)
autowrap_mode = 2
text = "⚠ Live preview active — do not save the scene until you press Stop Preview."

[node name="UIContainer" type="Control" parent="VBox/PreviewSection"]
layout_mode = 2
custom_minimum_size = Vector2(0, 90)

[node name="PourBar" type="HFlowContainer" parent="VBox/PreviewSection"]
layout_mode = 2

[node name="PourCheck" type="CheckBox" parent="VBox/PreviewSection/PourBar"]
layout_mode = 2
text = "Vertido (chorro de hormigón)"

[node name="PourSettingsToggle" type="Button" parent="VBox/PreviewSection/PourBar"]
layout_mode = 2
toggle_mode = true
flat = true
text = "▸ Ajustes"

[node name="PourGrid" type="GridContainer" parent="VBox/PreviewSection"]
layout_mode = 2
columns = 4
theme_override_constants/h_separation = 6

[node name="LblAmount" type="Label" parent="VBox/PreviewSection/PourGrid"]
layout_mode = 2
text = "Cantidad"

[node name="Amount" type="SpinBox" parent="VBox/PreviewSection/PourGrid"]
layout_mode = 2
min_value = 1
max_value = 20000
step = 10
value = 800

[node name="LblGrain" type="Label" parent="VBox/PreviewSection/PourGrid"]
layout_mode = 2
text = "Grano (m)"

[node name="Grain" type="SpinBox" parent="VBox/PreviewSection/PourGrid"]
layout_mode = 2
min_value = 0
max_value = 5
step = 0.01
value = 0

[node name="LblSpread" type="Label" parent="VBox/PreviewSection/PourGrid"]
layout_mode = 2
text = "Ángulo (°)"

[node name="Spread" type="SpinBox" parent="VBox/PreviewSection/PourGrid"]
layout_mode = 2
min_value = 0
max_value = 90
step = 0.5
value = 8

[node name="LblSpeed" type="Label" parent="VBox/PreviewSection/PourGrid"]
layout_mode = 2
text = "Velocidad"

[node name="Speed" type="SpinBox" parent="VBox/PreviewSection/PourGrid"]
layout_mode = 2
min_value = 0
max_value = 100
step = 0.1
value = 2

[node name="LblFall" type="Label" parent="VBox/PreviewSection/PourGrid"]
layout_mode = 2
text = "Altura caída (m)"

[node name="Fall" type="SpinBox" parent="VBox/PreviewSection/PourGrid"]
layout_mode = 2
min_value = 0
max_value = 100
step = 0.25
value = 0

[node name="LblSplash" type="Label" parent="VBox/PreviewSection/PourGrid"]
layout_mode = 2
text = "Salpicadura"

[node name="Splash" type="SpinBox" parent="VBox/PreviewSection/PourGrid"]
layout_mode = 2
min_value = 0
max_value = 20000
step = 10
value = 220

[node name="InspectorLabel" type="Label" parent="VBox/PreviewSection"]
layout_mode = 2
text = "Schedule Inspector"

[node name="FormworkBar" type="HFlowContainer" parent="VBox/PreviewSection"]
layout_mode = 2

[node name="FormworkCheck" type="CheckBox" parent="VBox/PreviewSection/FormworkBar"]
layout_mode = 2
text = "Encofrado en todo el proyecto"

[node name="FormworkPourLabel" type="Label" parent="VBox/PreviewSection/FormworkBar"]
layout_mode = 2
text = "Días vertido:"

[node name="FormworkPourSpin" type="SpinBox" parent="VBox/PreviewSection/FormworkBar"]
layout_mode = 2
min_value = 0.25
